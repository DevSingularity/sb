<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot's "parent" POM gives every starter, plugin, and transitive
        dependency a version that has been tested to work together. You almost
        never declare a <version> yourself below this line - the parent's BOM
        (Bill of Materials) supplies it. This is one of the biggest differences
        from a hand-rolled Node project like the original: there, every package
        pins its own semver range independently and nothing guarantees they
        actually work together.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>dev.singularity</groupId>
    <artifactId>urlshortener-springboot</artifactId>
    <version>1.0.0</version>
    <name>urlshortener-springboot</name>
    <description>URL shortener re-built from a Node/Express + Postgres + Redis service, on Spring Boot 4</description>

    <properties>
        <!-- Spring Boot 4 requires 17+; JDK 26 is the current non-LTS release
             (LTS is 25). Using it here to work with the newest toolchain,
             but 25-LTS is what you'd pick for a production service. -->
        <java.version>26</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- ===================== Web layer ===================== -->
        <!-- Embedded Tomcat + Spring MVC + Jackson 3 for JSON (de)serialisation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation (jakarta.validation) for @Valid / @NotBlank etc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ===================== Persistence ===================== -->
        <!-- Spring Data JPA (Hibernate 7) — replaces the hand-written `pg.js` /
             raw SQL strings from the Node version with repository interfaces. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway owns the schema instead of Hibernate auto-DDL. This is the
             production-grade equivalent of the original project's schema.sql
             file — every change is a numbered, version-controlled migration. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ===================== Caching ===================== -->
        <!-- Spring Data Redis (Lettuce client) backs the Spring Cache
             abstraction — @Cacheable/@CachePut/@CacheEvict — instead of the
             manual redisClient.get/setEx calls in urlService.js. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- ===================== Observability ===================== -->
        <!-- /actuator/health, /actuator/metrics etc. — production readiness
             endpoints the Node app had none of. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===================== Boilerplate reduction ===================== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===================== API docs ===================== -->
        <!-- Swagger UI at /swagger-ui.html — handy while you're still learning
             what your own endpoints look like. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- ===================== Testing ===================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Lets @ServiceConnection auto-wire a Testcontainers Redis too -->
            <groupId>com.redis</groupId>
            <artifactId>testcontainers-redis</artifactId>
            <version>2.2.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>1.21.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Packages the app as an executable "fat" jar and gives you
                 `mvn spring-boot:run` for local development. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Compile with --release 26 so the compiler enforces the
                 exact JDK 26 language + API surface, not just "whatever
                 JAVA_HOME happens to be". -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>26</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
